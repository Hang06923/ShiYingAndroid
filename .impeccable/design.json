  "narrative": {
    "northStar": "口袋里的取景册",
    "overview": "拾影不是一间视频网站，而是一本放在口袋里的小取景册：浅暖的纸面负责承载内容，深色的取景区负责聚焦链接，暖金色只标记现在可以做的那一步。界面始终像工具，不像内容平台的首页。整个界面保持单列、短路径和安静密度；视觉表达集中在一个取景框式预览、一个暖金主操作和一条明确进度线上。",
    "keyCharacteristics": [
      "暖灰纸面与近黑取景区形成单一强对比",
      "暖金是唯一主操作强调色，出现范围克制",
      "单列一屏，结果、当前任务和历史依次向下展开",
      "图标是同一套 1.75 描边 SVG，不使用 emoji",
      "实时支持浅色与深色系统主题，并尊重减少动效设置"
    ],
    "rules": [
      {
        "name": "取景框规则",
        "body": "深色只承担输入与媒体预览，不把整页染黑；浅色地面必须始终可见。",
        "section": "colors"
      },
      {
        "name": "琥珀稀缺规则",
        "body": "暖金只用于主操作和当前任务，不承担普通文字、装饰边框或大面积背景。",
        "section": "colors"
      },
      {
        "name": "单层深度规则",
        "body": "一个区域只使用背景材质或边框中的一种方式表达层级，不同时堆叠。",
        "section": "elevation"
      }
    ],
    "dos": [
      "让粘贴、解析、下载在同一个屏幕内闭环",
      "在深色输入与预览区域使用足够亮的正文和元数据",
      "保持 48px 触控区域和系统字体缩放",
      "用具体中文说明错误以及下一步"
    ],
    "donts": [
      "使用远程字体、远程图标或需要云端生成的界面资源",
      "把本地解析解释成不需要网络",
      "用多层卡片、彩色左边框或装饰性渐变掩盖信息结构",
      "给同一屏叠加多个主按钮"
    ]
  }
