      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-width:142px;height:48px;padding:0 18px;border:0;border-radius:14px;background:#E6AA4F;color:#181816;font:700 14px system-ui,sans-serif;transition:transform 190ms cubic-bezier(.2,.8,.2,1)}.ds-primary svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.75;stroke-linecap:round;stroke-linejoin:round}.ds-primary:active{transform:scale(.975)}.ds-primary:focus-visible{outline:3px solid rgba(230,170,79,.7);outline-offset:2px}"
