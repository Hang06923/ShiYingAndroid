      "css": ".ds-download{display:inline-flex;align-items:center;justify-content:center;gap:7px;height:48px;padding:0 17px;border:0;border-radius:14px;background:#181816;color:#F4F2EC;font:700 14px system-ui,sans-serif}.ds-download svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.75;stroke-linecap:round;stroke-linejoin:round}.ds-download:active{transform:scale(.975)}.ds-download:focus-visible{outline:3px solid rgba(230,170,79,.7);outline-offset:2px}"
